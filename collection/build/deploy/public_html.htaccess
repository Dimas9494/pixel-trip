# Site root — cache headers (Apache .htaccess; do NOT use LocationMatch here)
<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Token metadata cache busting: upload collection/build/deploy/metadata/.htaccess
# into public_html/metadata/.htaccess (FilesMatch only — safe in .htaccess).
